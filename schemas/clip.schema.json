{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "t": {
          "minimum": 0.0,
          "title": "T",
          "type": "number"
        },
        "type": {
          "enum": [
            "click",
            "tap",
            "key",
            "scroll",
            "screen",
            "back"
          ],
          "title": "Type",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "id",
        "t",
        "type"
      ],
      "title": "Event",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "video": {
      "title": "Video",
      "type": "string"
    },
    "width": {
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer"
    },
    "height": {
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer"
    },
    "fps": {
      "exclusiveMinimum": 0.0,
      "title": "Fps",
      "type": "number"
    },
    "duration": {
      "minimum": 0.0,
      "title": "Duration",
      "type": "number"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "id",
    "video",
    "width",
    "height",
    "fps",
    "duration"
  ],
  "title": "ClipModel",
  "type": "object"
}
