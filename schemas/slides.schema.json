    "ArchitectureSlide": {
      "additionalProperties": false,
      "description": "Boxes in columns joined by arrows. Each node is one build step, in layout order.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "eyebrow": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eyebrow"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        },
        "chapter": {
          "anyOf": [
            {
              "maximum": 99,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chapter"
        },
        "step_style": {
          "default": "dim",
          "enum": [
            "dim",
            "reveal"
