{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BulletsSlide": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "bullets",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "items"
      ],
      "title": "BulletsSlide",
      "type": "object"
    },
    "ChartSlide": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "chart",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "chart_type": {
          "enum": [
            "bars",
            "lines"
          ],
          "title": "Chart Type",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Labels",
          "type": "array"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "chart_type",
        "labels",
        "values"
      ],
      "title": "ChartSlide",
      "type": "object"
    },
    "FlowSlide": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "flow",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "exits": {
          "items": {
            "type": "string"
          },
          "title": "Exits",
          "type": "array"
        }
      },
      "required": [
        "id",
        "kind",
        "steps"
      ],
      "title": "FlowSlide",
      "type": "object"
    },
    "TitleSlide": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "title",
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtitle"
        }
      },
      "required": [
        "id",
        "kind",
        "title"
      ],
      "title": "TitleSlide",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "slides": {
      "items": {
        "discriminator": {
          "mapping": {
            "bullets": "#/$defs/BulletsSlide",
            "chart": "#/$defs/ChartSlide",
            "flow": "#/$defs/FlowSlide",
            "title": "#/$defs/TitleSlide"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TitleSlide"
          },
          {
            "$ref": "#/$defs/FlowSlide"
          },
          {
            "$ref": "#/$defs/ChartSlide"
          },
          {
            "$ref": "#/$defs/BulletsSlide"
          }
        ]
      },
      "minItems": 1,
      "title": "Slides",
      "type": "array"
    }
  },
  "required": [
    "slides"
  ],
  "title": "SlidesModel",
  "type": "object"
}
